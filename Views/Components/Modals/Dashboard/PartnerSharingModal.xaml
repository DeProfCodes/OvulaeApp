<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="OvulaeApp.Views.Components.Modals.Dashboard.PartnerSharingModal"
    x:Name="Root"
    xmlns:sharedComp="clr-namespace:OvulaeApp.Views.Components.Shared"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:viewmodels="clr-namespace:OvulaeApp.ViewModels.Authentication"
    xmlns:behaviors="clr-namespace:OvulaeApp.Helpers.UI.Behaviors"
    Background="#80000000">

    <ContentView.Resources>
        <ResourceDictionary>
            <viewmodels:PhoneEntryViewModel
                x:Key="PhoneEntryViewModel" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Fullscreen blocker -->
    <Grid
        BackgroundColor="#80000000"
        InputTransparent="False"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.Behaviors>
            <behaviors:DismissKeyboardBehavior />
        </Grid.Behaviors>
        
        <Border
            x:Name="MainBodyContainer"
            Background="White"
            Padding="0"
            StrokeShape="RoundRectangle 16"
            Stroke="#7ed957"
            StrokeThickness="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="320"
            HeightRequest="350">
            <Grid
                RowDefinitions="Auto,*,Auto">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Padding="10">
                    <Grid.Background>
                        <RadialGradientBrush
                            Center="0.5,0.5"
                            Radius="0.5">
                            <GradientStop
                                Color="#0097b2"
                                Offset="0.0" />
                            <GradientStop
                                Color="#7ed957"
                                Offset="1.0" />
                        </RadialGradientBrush>
                    </Grid.Background>
                    <Label
                        Grid.Column="0"
                        x:Name="ModalTitle"
                        Text="Invite your Partner"
                        Padding="4,0,0,0"
                        TextColor="{StaticResource White}"
                        HorizontalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Border
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 5"
                        Stroke="Transparent"
                        Background="{StaticResource ThemeClrMain}"
                        Padding="10,1,10,1"
                        HeightRequest="25">
                        <Label
                            Text="X"
                            TextColor="White"
                            FontFamily="Arial Black"
                            HorizontalTextAlignment="Start"
                            FontSize="14"
                            FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="CloseButton_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <ScrollView
                    Grid.Row="1">

                    <VerticalStackLayout>

                        <Label
                            x:Name="Title"
                            Text="Partner Sharing"
                            FontAttributes="Bold"
                            FontSize="14"
                            Margin="0,5,0,0"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource ThemeClr3}" />

                        <Label
                            x:Name="SubTitle"
                            Text="Share your partner’s details below so we can send them their login to join your journey."
                            FontSize="10"
                            Margin="10,5,10,3"
                            FontAttributes="Italic"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            TextColor="{StaticResource ThemeGray2}" />

                        <VerticalStackLayout
                            x:Name="InviteForm"
                            Spacing="7"
                            Margin="0,10,0,0">
                            <VerticalStackLayout>
                                <Border
                                    Stroke="{StaticResource ThemeClrMain}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,0,10,0"
                                    WidthRequest="250"
                                    Margin="0">

                                    <Entry
                                        x:Name="Email"
                                        TextChanged="OnFieldsChanged"
                                        Placeholder="Enter your email"
                                        Keyboard="Email"
                                        Margin="-5"
                                        TextColor="{StaticResource Black}"
                                        FontSize="12" />
                                </Border>
                                <Label
                                    x:Name="EmailValidation"
                                    Text="*Please enter valid email"
                                    Style="{StaticResource ValidationLabel}"
                                    Padding="35,0,5,0"
                                    HorizontalOptions="Start"
                                    IsVisible="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border
                                    Stroke="{StaticResource ThemeClrMain}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2,10,2"
                                    WidthRequest="250"
                                    Margin="0">
                                    
                                    <Entry
                                        x:Name="Firstname"
                                        TextChanged="OnFieldsChanged"
                                        Placeholder="Enter your firstname"
                                        TextColor="{StaticResource Black}"
                                        FontSize="12"
                                        Margin="-5"/>
                                </Border>
                                <Label
                                    x:Name="FirstnameValidation"
                                    Text="*Please enter firstname"
                                    Style="{StaticResource ValidationLabel}"
                                    Padding="5,0,5,0"
                                    HorizontalOptions="Center"
                                    IsVisible="False" />
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border
                                    Stroke="{StaticResource ThemeClrMain}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,2,10,2"
                                    WidthRequest="250"
                                    Margin="0">

                                    <Entry
                                        x:Name="Lastname"
                                        TextChanged="OnFieldsChanged"
                                        Placeholder="Enter your lastname"
                                        TextColor="{StaticResource Black}"
                                        FontSize="12"
                                        Margin="-5" />
                                </Border>
                                <Label
                                    x:Name="LastnameValidation"
                                    Text="*Please enter lastname"
                                    Style="{StaticResource ValidationLabel}"
                                    Padding="5,0,5,0"
                                    IsVisible="False" />
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Border
                                    Stroke="{StaticResource ThemeClrMain}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0,0"
                                    WidthRequest="250">

                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        VerticalOptions="Center"
                                        Padding="0,0"
                                        BindingContext="{StaticResource PhoneEntryViewModel}"
                                        Margin="-5">
                                        <!-- Country Code Picker -->
                                        <Border
                                            Background="{StaticResource ThemeGray}"
                                            Stroke="Transparent"
                                            Padding="4,0,2,0">
                                            <Picker
                                                x:Name="CountryCode"
                                                ItemsSource="{Binding CountryCodes}"
                                                SelectedItem="{Binding SelectedCountryCode}"
                                                FontSize="12"
                                                WidthRequest="70"
                                                HorizontalTextAlignment="Center"
                                                Title="Code"
                                                TextColor="Black" />
                                        </Border>
                                        <!-- Phone Number Entry -->
                                        <Entry
                                            x:Name="PhoneNumber"
                                            Grid.Column="1"
                                            TextChanged="OnFieldsChanged"
                                            Placeholder="Phone Number"
                                            Text="{Binding PhoneNumber}"
                                            FontSize="12"
                                            Keyboard="Telephone"
                                            TextColor="Black"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            Margin="5,0,0,0" />
                                    </Grid>
                                </Border>
                                <Label
                                    x:Name="PhoneNumberValidation"
                                    Text="*Please valid Phone Number"
                                    Style="{StaticResource ValidationLabel}"
                                    Padding="5,0,5,0"
                                    IsVisible="False" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="LoadingContainer"
                            IsVisible="False">
                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource ThemeClrMain}"
                                WidthRequest="60"
                                HeightRequest="60"
                                Margin="0,0,0,10" />
                            <Label
                                Text="Sharing your experience with your partner..."
                                FontSize="14"
                                TextColor="{StaticResource ThemeClrMain}"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                FontFamily="Arial Black"
                                Margin="0,0,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="InviteStatusContainer"
                            IsVisible="False"
                            VerticalOptions="Center"
                            Margin="15,35,15,0">

                            <Label
                                x:Name="InviteStatusText"
                                Text=""
                                FontSize="12"
                                FontAttributes="Italic, Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Border
                    Grid.Row="2"
                    StrokeShape="RoundRectangle 5"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeLightGray}"
                    Margin="0,0,0,0">
                    <HorizontalStackLayout
                        HorizontalOptions="CenterAndExpand">
                        <Border
                            x:Name="BackBtn"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            IsVisible="False"
                            Stroke="Transparent"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="0,5,0,5">
                            <Label
                                x:Name="BackBtnTxt"
                                Text="Back"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="BackButtonTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="InvitePartnerBtn"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            Stroke="Transparent"
                            Opacity="0.3"
                            IsEnabled="False"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="5,5,0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="InvitePartnerBtnTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="NextBtnTxt"
                                Text="Invite"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>