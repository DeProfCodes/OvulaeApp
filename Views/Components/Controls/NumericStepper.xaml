<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="OvulaeApp.Views.Components.Controls.NumericStepper"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        x:Name="OuterBorder"
        HorizontalOptions="{Binding HorizontalOptions, Source={x:Reference Root}}"
        StrokeShape="RoundRectangle 5"
        Padding="{Binding Padding, Source={x:Reference Root}}"
        Margin="{Binding Margin, Source={x:Reference Root}}"
        HeightRequest="{Binding HeightRequest, Source={x:Reference Root}}"
        WidthRequest="{Binding WidthRequest, Source={x:Reference Root}}"
        BackgroundColor="{Binding OuterBackground, Source={x:Reference Root}}"
        Stroke="{Binding OuterStroke, Source={x:Reference Root}}">

        <Grid
            ColumnDefinitions="*,*,*">

            <!-- Decrease -->
            <Border
                x:Name="DecreaseBorder"
                Grid.Column="0"
                WidthRequest="{Binding IconContainerWidth, Source={x:Reference Root}}"
                StrokeShape="RoundRectangle 5,0,5,0"
                Padding="5"
                BackgroundColor="{Binding DecreaseBackground, Source={x:Reference Root}}"
                Stroke="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnDecreaseTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="{Binding DecreaseIconSource, Source={x:Reference Root}}"
                    WidthRequest="{Binding IconWidth, Source={x:Reference Root}}"
                    Aspect="AspectFit"
                    Margin="0,4,0,0"
                    VerticalOptions="Center" />
            </Border>

            <!-- Entry -->
            <Border
                x:Name="EntryBorder"
                Grid.Column="1"
                WidthRequest="{Binding EntryContainerWidth, Source={x:Reference Root}}"
                Padding="0,5"
                BackgroundColor="{Binding EntryBackground, Source={x:Reference Root}}"
                Stroke="Transparent">
                <Entry
                    x:Name="EntryField"
                    Text="{Binding Value, Source={x:Reference Root}, Mode=TwoWay}"
                    FontSize="{Binding FontSize, Source={x:Reference Root}}"
                    HeightRequest="{Binding EntryHeight, Source={x:Reference Root}}"
                    FontAttributes="Bold"
                    FontFamily="Arial Black"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Keyboard="Numeric"
                    TextChanged="EntryField_TextChanged"
                    Unfocused="EntryField_Unfocused"
                    TextColor="{Binding EntryTextColor, Source={x:Reference Root}}" />
            </Border>

            <!-- Increase -->
            <Border
                x:Name="IncreaseBorder"
                Grid.Column="2"
                WidthRequest="{Binding IconContainerWidth, Source={x:Reference Root}}"
                StrokeShape="RoundRectangle 0,5,0,5"
                Padding="5"
                BackgroundColor="{Binding IncreaseBackground, Source={x:Reference Root}}"
                Stroke="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnIncreaseTapped" />
                </Border.GestureRecognizers>
                <Image
                    Source="{Binding IncreaseIconSource, Source={x:Reference Root}}"
                    WidthRequest="{Binding IconWidth, Source={x:Reference Root}}"
                    Aspect="AspectFit"
                    VerticalOptions="Center" />
            </Border>

        </Grid>
    </Border>
</ContentView>