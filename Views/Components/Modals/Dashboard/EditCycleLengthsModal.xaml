<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="OvulaeApp.Views.Components.Modals.Dashboard.EditCycleLengthsModal"
    x:Name="Root"
    xmlns:sharedComp="clr-namespace:OvulaeApp.Views.Components.Shared"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:behaviors="clr-namespace:OvulaeApp.Helpers.UI.Behaviors"
    Background="#80000000">

    <!-- Fullscreen blocker -->
    <Grid
        BackgroundColor="#80000000"
        InputTransparent="False"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.Behaviors>
            <behaviors:DismissKeyboardBehavior />
        </Grid.Behaviors>
        
        <Border
            Background="White"
            Padding="0"
            StrokeShape="RoundRectangle 16"
            Stroke="{StaticResource ThemeClr2}"
            StrokeThickness="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="320"
            HeightRequest="300">
            <Grid
                RowDefinitions="Auto,*,Auto">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Background="#FFF5FF"
                    Padding="10">
                    <Label
                        Grid.Column="0"
                        Text="Edit Cycle Days"
                        Padding="4,0,0,0"
                        TextColor="{StaticResource ThemeClrMain}"
                        HorizontalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Border
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 5"
                        Stroke="Transparent"
                        Background="{StaticResource ThemeClrMain}"
                        Padding="10,1,10,1"
                        HeightRequest="25">
                        <Label
                            Text="X"
                            TextColor="White"
                            FontFamily="Arial Black"
                            HorizontalTextAlignment="Start"
                            FontSize="14"
                            FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="CloseButton_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <ScrollView
                    Grid.Row="1">

                    <VerticalStackLayout>

                        <Label
                            Text="Change your menstrual cylce lengths"
                            FontAttributes="Bold"
                            FontSize="14"
                            Margin="0,5,0,0"
                            HorizontalOptions="Center"
                            TextColor="Black" />

                        <!-- LMP -->
                        <VerticalStackLayout
                            x:Name="LMPOption">
                            <Label
                                Text="When did you last period start?"
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="0,20,0,20" />
                            <HorizontalStackLayout
                                HorizontalOptions="Center">
                                <Label
                                    Text="Select Date"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource Black}"
                                    Margin="0,0,10,0" />

                                <customCtrl:DatePicker
                                    x:Name="LastPeriodDate"
                                    DateColor="{StaticResource ThemeClrMain}"
                                    FontSize="14" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="CycleLength">
                            <Label
                                Text="How long is your usual menstrual cycle?"
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="0,20,0,30" />
                            <HorizontalStackLayout
                                HorizontalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    Text="Enter Days"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource Black}"
                                    Margin="0,0,10,0" />

                                <customCtrl:NumericStepper
                                    x:Name="CycleLengthValue"
                                    Value="28"
                                    Min="21"
                                    Max="45"
                                    FontSize="14" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            x:Name="CycleDuration">
                            <Label
                                Text="How many days does your period usually last?"
                                FontSize="14"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="10,20,10,20" />
                            <HorizontalStackLayout
                                HorizontalOptions="Center">
                                <Label
                                    Grid.Column="0"
                                    Text="Enter Days"
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource Black}"
                                    Margin="0,0,10,0" />

                                <customCtrl:NumericStepper
                                    x:Name="CycleDurationValue"
                                    Value="5"
                                    Min="2"
                                    Max="10"
                                    FontSize="14" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </ScrollView>

                <Border
                    Grid.Row="2"
                    StrokeShape="RoundRectangle 5"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeLightGray}"
                    Margin="0,0,0,0">
                    <HorizontalStackLayout
                        HorizontalOptions="CenterAndExpand">
                        <Border
                            x:Name="BackBtnTxt"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            IsVisible="False"
                            Stroke="Transparent"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="0,5,0,5">
                            <Label
                                Text="Close"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="CloseButton_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            Stroke="Transparent"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="5,5,0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="NextButtonTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="NextBtnTxt"
                                Text="Save Changes"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>