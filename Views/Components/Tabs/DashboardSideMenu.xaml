<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Components.Tabs.DashboardSideMenu"
    x:Name="Root"
    IsVisible="False"
    BackgroundColor="Transparent"
    ZIndex="200">

    <Grid>
        <!-- Overlay for tap-to-close -->
        <ContentView
            x:Name="Overlay"
            BackgroundColor="#80000000"
            Opacity="0">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnOverlayTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>

        <!-- Side Menu Tray -->
        <Border
            x:Name="SideMenuTray"
            WidthRequest="250"
            BackgroundColor="{StaticResource ThemeClrMainDark}"
            Padding="0"
            HorizontalOptions="Start"
            TranslationX="-250">

            <Grid
                RowDefinitions="Auto,*,Auto"
                Padding="0">

                <!-- Header -->
                <VerticalStackLayout
                    Grid.Row="0"
                    Padding="20">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        VerticalOptions="Center">
                        <Label
                            Text="Ovulae Menu"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Grid
                            Grid.Column="1"
                            WidthRequest="20"
                            HeightRequest="20"
                            Padding="5">
                            <ImageButton
                                Source="close_icon_white.png"
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Clicked="OnCloseButtonClicked"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </Grid>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="White"
                        Margin="0,10,0,0"
                        Opacity="0.3" />

                </VerticalStackLayout>

                <!-- Navigation Items -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="15,0,0,0"
                    Margin="0,-15,0,0">

                    <!-- Home -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Home" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="home_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Home"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Education -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="EducationMain" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="edu_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Education"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Calendar -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Calendar" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="calendar_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Calendar"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Profile -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Profile" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="profile_icon_white.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Profile"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />
                    
                    <!-- Settings -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Settings" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="settings_icon_white.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Settings"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Sharing -->
                    <Border
                        Padding="7"
                        Stroke="Transparent"
                        IsVisible="{Binding IsMainUser}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="PartnerSharing" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="partner_sharing_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Partner Sharing"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Switch Tracker -->
                    <Border
                        Padding="7"
                        Stroke="Transparent"
                        IsVisible="{Binding IsMainUser}"
                        x:Name="SwitchTrackerBtn">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="SwitchTrackerTapped" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="switch_white_icon_2.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Switch Tracker"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout
                        x:Name="SwitchTrackerGroup"
                        IsVisible="False">
                        <Border
                            Padding="15,5"
                            StrokeShape="RoundRectangle 8"
                            Margin="0,0,20,0"
                            StrokeThickness="0.5"
                            Stroke="{StaticResource White}"
                            Background="Transparent">

                            <VerticalStackLayout>
                                <Border
                                    Padding="7"
                                    Stroke="Transparent"
                                    Background="Transparent"
                                    IsVisible="{Binding ShowSwitchToPregnancy}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="SwitchTrackerItemTapped"
                                            CommandParameter="Pregnancy" />
                                    </Border.GestureRecognizers>
                                    <Grid
                                        ColumnDefinitions="20,*">
                                        <Image
                                            Grid.Column="0"
                                            Source="pregnancy_white_icon.png"
                                            HeightRequest="14"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Pregnancy Tracker"
                                            FontSize="14"
                                            TextColor="White"
                                            Margin="5,0,0,0"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <BoxView
                                    HeightRequest="0.3"
                                    Color="{StaticResource White}"
                                    Opacity="0.5"
                                    WidthRequest="150"
                                    HorizontalOptions="Start"
                                    Margin="10,0,0,0" />
                                
                                <Border
                                    Padding="7"
                                    Stroke="Transparent"
                                    Background="Transparent"
                                    IsVisible="{Binding ShowSwitchToPeriodTracker}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="SwitchTrackerItemTapped"
                                            CommandParameter="PeriodTracker" />
                                    </Border.GestureRecognizers>
                                    <Grid
                                        ColumnDefinitions="20,*">
                                        <Image
                                            Grid.Column="0"
                                            Source="period_tracker_white_icon.png"
                                            HeightRequest="14"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Period Tracker"
                                            FontSize="14"
                                            TextColor="White"
                                            Margin="5,0,0,0"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <BoxView
                                    HeightRequest="0.3"
                                    Color="{StaticResource White}"
                                    Opacity="0.5"
                                    WidthRequest="150"
                                    HorizontalOptions="Start"
                                    Margin="10,0,0,0" />

                                <Border
                                    Padding="7"
                                    Stroke="Transparent"
                                    Background="Transparent"
                                    IsVisible="{Binding ShowSwitchToOvulation}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="SwitchTrackerItemTapped"
                                            CommandParameter="Ovulation" />
                                    </Border.GestureRecognizers>
                                    <Grid
                                        ColumnDefinitions="20,*">
                                        <Image
                                            Grid.Column="0"
                                            Source="baby_white_icon.png"
                                            HeightRequest="14"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Ovulation Tracker"
                                            FontSize="14"
                                            TextColor="White"
                                            Margin="5,0,0,0"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <BoxView
                                    HeightRequest="0.3"
                                    Color="{StaticResource White}"
                                    Opacity="0.5"
                                    WidthRequest="150"
                                    HorizontalOptions="Start"
                                    Margin="10,0,0,0" />

                                <Border
                                    Padding="7"
                                    Stroke="Transparent"
                                    Background="Transparent"
                                    IsVisible="{Binding ShowSwitchToMenopause}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="SwitchTrackerItemTapped"
                                            CommandParameter="MenopauseTracker" />
                                    </Border.GestureRecognizers>
                                    <Grid
                                        ColumnDefinitions="20,*">
                                        <Image
                                            Grid.Column="0"
                                            Source="menopause_white_icon.png"
                                            HeightRequest="14"
                                            Aspect="AspectFit"
                                            HorizontalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Text="Menopause Tracker"
                                            FontSize="14"
                                            TextColor="White"
                                            Margin="5,0,0,0"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </Border>


                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    
                    <!-- About -->
                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="AboutUs" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="about_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="About"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <!-- Help -->
                    <Border
                        Padding="7"
                        Stroke="Transparent"
                        IsVisible="{Binding IsMainUser}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Help" />
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="help_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Help"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <BoxView
                        HeightRequest="0.3"
                        Color="{StaticResource White}"
                        Opacity="0.3"
                        WidthRequest="150"
                        HorizontalOptions="Start"
                        Margin="10,0,0,0" />

                    <Border
                        Padding="7"
                        Stroke="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="NavigationButtonClicked"
                                CommandParameter="Login"/>
                        </Border.GestureRecognizers>
                        <Grid
                            ColumnDefinitions="20,*">
                            <Image
                                Grid.Column="0"
                                Source="logout_side_icon.png"
                                HeightRequest="17"
                                Aspect="AspectFit"
                                HorizontalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Logout"
                                FontSize="16"
                                TextColor="White"
                                Margin="8,0,0,0"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- Footer -->
                <Grid
                    Grid.Row="2"
                    VerticalOptions="End"
                    Padding="0,30,0,20">
                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        Spacing="5">

                        <!-- Logo -->
                        <Image
                            Source="logo_icon_white.png"
                            WidthRequest="50"
                            Aspect="AspectFit"
                            HorizontalOptions="Center" />

                        <!-- App Version -->
                        <Label
                            Text="{Binding AppVersion}"
                            FontSize="12"
                            TextColor="White"
                            HorizontalOptions="Center"
                            FontAttributes="Italic" />

                        <!-- Privacy and Terms -->
                        <HorizontalStackLayout
                            Spacing="15"
                            HorizontalOptions="Center">

                            <Label
                                Text="Privacy Policy"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource ThemeClr3}"
                                TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnPrivacyTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label
                                Text="Terms of Use"
                                FontSize="12"
                                TextColor="{StaticResource ThemeClr3}"
                                FontAttributes="Bold"
                                TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnTermsTapped" />
                                </Label.GestureRecognizers>
                            </Label>

                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>