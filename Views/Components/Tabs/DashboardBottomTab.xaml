<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Components.Tabs.DashboardBottomTab"
    x:Name="Root">

    <Border
        Padding="5,5"
        StrokeThickness="0.5"
        Margin="0,0,0,-1"
        Stroke="{StaticResource ThemeClrMain}">
        <Grid
            x:Name="TabContainer"
            MaximumWidthRequest="600"
            ColumnSpacing="10"
            Padding="10,0" />
    </Border>

</ContentView>