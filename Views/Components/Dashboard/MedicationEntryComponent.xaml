<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    x:Class="OvulaeApp.Views.Components.Dashboard.MedicationEntryComponent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout>

        <!-- Dynamic Medication Entries -->
        <VerticalStackLayout 
            x:Name="MedicationEntriesContainer"
            Spacing="10"
            BindableLayout.ItemsSource="{Binding MedicationEntries, Source={x:Reference Root}}">

            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Border
                        Stroke="{StaticResource ThemeClrMain}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="15,10"
                        Background="{StaticResource ThemeGrayLight}">

                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">

                            <!-- Medication Name -->
                            <VerticalStackLayout Grid.Column="0">
                                <Label
                                    Text="Medication Name"
                                    FontSize="10"
                                    FontAttributes="Italic"
                                    TextColor="{StaticResource ThemeGray2}"
                                    Margin="0,0,0,2" />
                                <Entry
                                    Text="{Binding MedicationName}"
                                    Placeholder="e.g., Ozempic"
                                    FontSize="14"
                                    TextColor="Black"
                                    PlaceholderColor="{StaticResource ThemeGray2}"
                                    Completed="MedicationEntry_Completed" />
                                <Border 
                                    Stroke="{StaticResource ThemeClrMainDark}"/>
                            </VerticalStackLayout>

                            <!-- Dosage -->
                            <VerticalStackLayout Grid.Column="1">
                                <Label
                                    Text="Dosage"
                                    FontSize="10"
                                    FontAttributes="Italic"
                                    TextColor="{StaticResource ThemeGray2}"
                                    Margin="0,0,0,2" />
                                <Entry
                                    Text="{Binding Dosage}"
                                    Placeholder="e.g., 1.5mg"
                                    FontSize="14"
                                    TextColor="Black"
                                    PlaceholderColor="{StaticResource ThemeGray2}"
                                    Completed="MedicationEntry_Completed" />
                                <Border 
                                    Stroke="{StaticResource ThemeClrMainDark}"/>
                            </VerticalStackLayout>

                            <!-- Remove Button -->
                            <Border
                                Grid.Column="2"
                                Stroke="Transparent"
                                Background="{StaticResource ThemeClrRedLight}"
                                StrokeShape="RoundRectangle 8"
                                WidthRequest="40"
                                HeightRequest="40"
                                VerticalOptions="Center">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding RemoveCommand}" />
                                </Border.GestureRecognizers>

                                <Image
                                    Source="close_icon.png"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>

        </VerticalStackLayout>

        <!-- Add Medication Button -->
        <Border
            Stroke="{StaticResource ThemeClrMain}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 12"
            Background="Transparent"
            Padding="15,10"
            Margin="0,10,0,0">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AddMedication_Tapped" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout
                Spacing="10"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Image
                    Source="add_icon.png"
                    WidthRequest="20"
                    HeightRequest="20"
                    VerticalOptions="Center" />

                <Label
                    x:Name="AddButtonLabel"
                    Text="Add Medication"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="{StaticResource ThemeClrMain}"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentView>