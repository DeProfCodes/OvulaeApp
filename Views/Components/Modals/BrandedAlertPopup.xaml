<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="OvulaeApp.Views.Components.Modals.BrandedAlertPopup"
    Size="300,200"
    Color="Transparent">

    <Border
        Background="White"
        Padding="0"
        StrokeShape="RoundRectangle 16"
        Stroke="{StaticResource ThemeClr2}"
        StrokeThickness="2">
        <Grid 
            RowDefinitions="Auto,*,Auto">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Background="#FFF5FF"
                Padding="10">
                <Label
                    Grid.Column="0"
                    x:Name="PopupTitle"
                    Text="Title"
                    Padding="8,0,0,0"
                    TextColor="{StaticResource ThemeClrMain}"
                    HorizontalTextAlignment="Start"
                    FontSize="18"
                    FontAttributes="Bold"
                    />
                <Border
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 5"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeClrMain}"
                    Padding="10,1,10,1">
                    <Label
                        Text="X"
                        TextColor="White"
                        FontFamily="Arial Black"
                        HorizontalTextAlignment="Start"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="CloseXButtonTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
            
            <Label
                Grid.Row="1"
                x:Name="PopupMessage"
                Text="Message"
                TextColor="Black"
                Padding="10,0"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" 
                FontSize="14" />
            <Border
                Grid.Row="2"
                Background="{StaticResource ThemeLightGray}"
                Stroke="Transparent">
                <Border
                    StrokeShape="RoundRectangle 5"
                    HorizontalOptions="Center"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeClrMain}"
                    Padding="15,5,15,5"
                    Margin="0,3,0,3">
                    <Label
                        x:Name="CloseBtnTxt"
                        Text="Close"
                        FontAttributes="Bold"
                        FontSize="14"
                        FontFamily="Arial Black"
                        TextColor="White" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="CloseXButtonTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Border>
            
        </Grid>
    </Border>
</toolkit:Popup>