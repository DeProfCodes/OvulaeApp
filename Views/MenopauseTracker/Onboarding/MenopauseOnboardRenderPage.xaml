            BackClicked="IntraMarketingPageContainer_BackClicked"
            DotCurrentIndex="6"
            DotTotalIndices="20"
            FeatureType="Dashboard"
            IsVisible="False" />
        
        <adPages:AdModuleFeaturePage
            x:Name="CalendarAdPage"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            NextClicked="NextOnboardBtn_Clicked"
            BackClicked="IntraMarketingPageContainer_BackClicked"
            DotCurrentIndex="9"
            DotTotalIndices="20"
            FeatureType="Calendar"
            IsVisible="False" />

        <adPages:AdModuleFeaturePage
            x:Name="ChatBotAdPage"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            NextClicked="NextOnboardBtn_Clicked"
            BackClicked="IntraMarketingPageContainer_BackClicked"
            DotCurrentIndex="12"
            DotTotalIndices="20"
            FeatureType="ChatBot"
            IsVisible="False" />

        <adPages:AdModuleFeaturePage
            x:Name="EducationBooksAdPage"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            NextClicked="NextOnboardBtn_Clicked"
            BackClicked="IntraMarketingPageContainer_BackClicked"
