<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="OvulaeApp.Views.Components.Dashboard.EducationalBooksListing"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <VerticalStackLayout
        Padding="0,10">
        <Label
            Text="{Binding Title, Source={x:Reference Root}}"
            FontSize="{Binding LabelFontSize, Source={x:Reference Root}}"
            FontAttributes="{Binding LabelFontAttributes, Source={x:Reference Root}}"
            TextColor="{Binding LabelTextColor, Source={x:Reference Root}}"
            Margin="{Binding LabelMargin, Source={x:Reference Root}}" />

        <ScrollView
            Orientation="Horizontal"
            Margin="0,10,0,0">
            <HorizontalStackLayout
                x:Name="BookStack"
                Spacing="10"
                Padding="20,0,0,0"/>
        </ScrollView>
    </VerticalStackLayout>
</ContentView>