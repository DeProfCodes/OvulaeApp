<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Components.Controls.Checkbox"
    x:Name="RootCheckbox"
    WidthRequest="16"
    HeightRequest="16">
    <Grid>
        <Ellipse
            Fill="Transparent"
            Stroke="{StaticResource ThemeClr2}" />

        <Image
            x:Name="CheckImage"
            Source="checked_icon.png"
            IsVisible="{Binding IsChecked, Source={x:Reference RootCheckbox}}"
            Aspect="AspectFit" />

        <Grid.GestureRecognizers>
            <TapGestureRecognizer
                Tapped="OnCheckboxTapped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>