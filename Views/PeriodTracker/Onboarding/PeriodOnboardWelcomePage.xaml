<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.PeriodTracker.Onboarding.PeriodOnboardWelcomePage"
    Background="White"
    xmlns:viewmodels="clr-namespace:OvulaeApp.ViewModels.Shared"
    xmlns:custButtons="clr-namespace:OvulaeApp.Views.Components.Controls.Buttons"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals">

    <AbsoluteLayout>
        <Grid
            RowDefinitions="Auto,*,Auto"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">

            <!-- Title -->
            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,0"
                Margin="0,20,0,0">
                <HorizontalStackLayout>
                    <Image
                        Grid.Row="2"
                        Source="menstrual_icon.png"
                        WidthRequest="28"
                        Aspect="AspectFit"
                        Margin="0,0,0,0" />
                    <Label
                        Text="Menstrual Cycle Tracker"
                        TextColor="#4506dd"
                        FontAttributes="Bold"
                        FontSize="25"
                        FontFamily="Arial Black"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center"
                        Margin="10,0,0,0" />
                </HorizontalStackLayout>
                <Border
                    HeightRequest="2"
                    Stroke="#4506dd"
                    BackgroundColor="#4506dd"
                    StrokeThickness="0"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Center"
                    Margin="0,5" />
            </VerticalStackLayout>

            <!-- Body -->
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="20"
                Padding="20">

                <Border
                    HeightRequest="160"
                    Margin="0,0,0,0"
                    StrokeShape="RoundRectangle 12"
                    Stroke="Transparent"
                    HorizontalOptions="Center">
                    <Image
                        Source="period_tracker.png"
                        Aspect="Fill" />
                </Border>

                <Label
                    Text="Welcome to Menstrual Cycle Tracking"
                    Style="{StaticResource Headline}"
                    HorizontalOptions="Start"
                    TextColor="{StaticResource ThemeClrMainDark}"
                    FontSize="17"
                    Margin="0,0,0,0" />

                <Label
                    Text="We’re here to help you better understand your body, track your period, and uncover patterns that matter. To do this, we’ll ask a few short questions — things like your cycle habits, and how you’ve been feeling lately."
                    FontSize="12"
                    TextColor="{StaticResource ThemeGray2}"
                    Margin="0,0,0,0" />

                <VerticalStackLayout>
                    <Label
                        Text=""
                        FontSize="14"
                        TextColor="{StaticResource ThemeClrMain}"
                        FontAttributes="Bold"
                        FontFamily="Arial Black"
                        Margin="0,0,0,0" />
                    <Label
                        Text="Note: Everything you share stays private and is only used to personalize your experience."
                        FontSize="14"
                        TextColor="Black"
                        FontAttributes="Bold"
                        FontFamily="Arial Black"
                        Margin="0,10,0,0"
                        LineBreakMode="WordWrap"
                        HorizontalOptions="FillAndExpand" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    Spacing="10">

                </VerticalStackLayout>
            </VerticalStackLayout>
            <VerticalStackLayout
                Grid.Row="2">
                <Image
                    Source="logo_icon.png"
                    WidthRequest="70"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,0,0,30" />
                <custButtons:GradientButton
                    Text="START"
                    Grid.Row="1"
                    FontAttributes="Bold"
                    FontSize="16"
                    ButtonPadding="20,13"
                    Margin="20,0,20,10"
                    Stroke="Transparent"
                    CornerRadius="15"
                    ShadowOpacity="0.4"
                    ButtonTextColor="White"
                    GradientColorLeft="{StaticResource ThemeClr3}"
                    GradientColorRight="{StaticResource ThemeClr2}"
                    Tapped="StartPeriodOnboardBtn_Clicked" />
            </VerticalStackLayout>

        </Grid>

        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="Spinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>
