<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OvulaeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OvulaeApp"
    xmlns:splash="clr-namespace:OvulaeApp.Views.Splashscreen"
    xmlns:authPages="clr-namespace:OvulaeApp.Views.Authentication"
    xmlns:dash="clr-namespace:OvulaeApp.Views.PregnancyTracking.Dashboard"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals"
    xmlns:dashComp="clr-namespace:OvulaeApp.Views.Components.Dashboard"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    Title="OvulaeApp">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
</Shell>
