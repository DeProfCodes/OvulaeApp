<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Components.Shared.FeatureBadge"
    x:Name="Root">

    <Border
        StrokeShape="RoundRectangle 12"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        Padding="5,10">
        <VerticalStackLayout
            Spacing="5"
            HorizontalOptions="Center">
            <Image
                Source="{Binding Source={x:Reference Root}, Path=Icon}"
                HeightRequest="30"
                HorizontalOptions="Center" />
            <Label
                Text="{Binding Source={x:Reference Root}, Path=Title}"
                FontSize="10"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#6A35B8" />
        </VerticalStackLayout>
    </Border>
</ContentView>