<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OvulaeApp.Helpers.UI"
    xmlns:lottie="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    x:Class="OvulaeApp.Views.Components.Modals.AppLoader"
    x:Name="LoaderRoot"
    IsVisible="False"
    BackgroundColor="#80000000"
    ZIndex="200">
    <!-- dimmed background -->

    <Grid>
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Padding="10,20,10,0"
            BackgroundColor="White"
            WidthRequest="250"
            HeightRequest="150"
            StrokeShape="RoundRectangle 20">
            <VerticalStackLayout
                Spacing="15">
                <local:GifLoaderView
                    x:Name="AppLoaderAnimation"
                    WidthRequest="150"
                    HeightRequest="150"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <Label
                    x:Name="LoaderMessage"
                    Text="Loading..."
                    FontSize="14"
                    TextColor="Black"
                    VerticalOptions="End"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>