<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Authentication.LoginPage"
    Background="White"
    xmlns:viewmodels="clr-namespace:OvulaeApp.ViewModels.Shared"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <viewmodels:NavigationsViewModel
                x:Key="NavigationsVM" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <AbsoluteLayout>
        <!-- Scrollable Content -->
        <ContentView
            x:Name="MainPageContainer"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <ScrollView>
                <VerticalStackLayout
                    Spacing="30"
                    Padding="20,0">
                    <!-- Bottom Logo -->
                    <Image
                        Source="logo_main.png"
                        WidthRequest="128"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        Margin="0,40,0,0" />

                    <VerticalStackLayout>
                        <Label
                            Text="Login to your Account"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Center"
                            FontFamily="Inter"
                            TextColor="Black" />
                        <Label
                            Text="Welcome back to our app"
                            FontSize="14"
                            HorizontalOptions="Center"
                            TextColor="Black"
                            Margin="0,7,0,7" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Spacing="10">
                        <VerticalStackLayout>
                            <Border
                                Stroke="{StaticResource ThemeClrMain}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2,10,2"
                                Margin="0">

                                <Entry
                                    x:Name="Email"
                                    Placeholder="Enter your email"
                                    TextColor="{StaticResource Black}"
                                    FontSize="16"
                                    Keyboard="Email"
                                    TextChanged="OnFieldsChanged" />
                            </Border>
                            <Label
                                x:Name="EmailValidation"
                                Text="*Email is not in correct format!"
                                Style="{StaticResource ValidationLabel}"
                                Padding="5,0,5,0"
                                IsVisible="False" />
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Border
                                Stroke="{StaticResource ThemeClrMain}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,2,5,2"
                                Margin="0">
                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Entry
                                        Grid.Column="0"
                                        x:Name="Password"
                                        Placeholder="Enter your password"
                                        TextColor="{StaticResource Black}"
                                        FontSize="16"
                                        IsPassword="True"
                                        TextChanged="OnFieldsChanged" />
                                    <Border
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Padding="5,0"
                                        Stroke="Transparent">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="TapGestureRecognizer_Tapped" />
                                        </Border.GestureRecognizers>
                                        <Image
                                            x:Name="PasswordCover"
                                            Source="eye_show.png"
                                            HeightRequest="20" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid
                                ColumnDefinitions="Auto,*">
                                <Label
                                    Grid.Column="0"
                                    x:Name="PasswordValidation"
                                    Text="*Incorrect Password!"
                                    Style="{StaticResource ValidationLabel}"
                                    Padding="5,0,5,0"
                                    IsVisible="False" />
                                <Label
                                    Grid.Column="1"
                                    Text="Forgot Password?"
                                    FontSize="14"
                                    FontAttributes="Bold,Italic"
                                    HorizontalOptions="End"
                                    FontFamily="Arial Black"
                                    TextColor="{StaticResource ThemeClr2}"
                                    Margin="-10,0,-0,0"
                                    Padding="10,5,0,5">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="ForgotPasswordTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                        </VerticalStackLayout>

                        <!-- Bottom Button -->
                        <Button
                            x:Name="LoginBtn"
                            Grid.Row="2"
                            Text="Login"
                            Style="{StaticResource ThemeButton}"
                            Margin="0,0,0,0"
                            Clicked="LoginBtn_Clicked"
                            IsEnabled="False"
                            Opacity="0.3" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center">
                            <Label
                                Text="Don't have account yet?"
                                FontSize="14"
                                TextColor="Black" 
                                VerticalOptions="Center"/>
                            <Label
                                Text="SIGN UP"
                                FontSize="14"
                                FontAttributes="Bold,Italic"
                                FontFamily="Arial Black"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="-5,-8,-10,-10"
                                Padding="10,10,10,10"
                                BindingContext="{StaticResource NavigationsVM}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="SignUpLink_Tapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout
                        IsVisible="False">
                        <Line
                            StrokeThickness="1"
                            X1="0"
                            X2="145"
                            Stroke="{StaticResource ThemeGray}"
                            VerticalOptions="Center" />
                        <Label
                            Text="or"
                            FontSize="14"
                            TextColor="{StaticResource ThemeGray}"
                            Margin="5,-2,5,0" />
                        <Line
                            StrokeThickness="1"
                            X1="0"
                            X2="145"
                            Stroke="{StaticResource ThemeGray}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout
                        Margin="0,-25"
                        Spacing="10"
                        IsVisible="False">
                        <Border
                            Background="{StaticResource ThemeLightGray}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="13"
                            Margin="0">
                            <HorizontalStackLayout
                                HorizontalOptions="Center">
                                <Image
                                    Source="google_icon.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    Aspect="AspectFit"
                                    Margin="0,0,0,0" />
                                <Label
                                    Text="Login with Google"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    TextColor="Black"
                                    Margin="10,0,0,0" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="GoogleLoginBtn_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="AppleLoginBtn"
                            Background="{StaticResource ThemeLightGray}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="13"
                            Margin="0">

                            <HorizontalStackLayout
                                HorizontalOptions="Center">
                                <Image
                                    Source="apple_icon.png"
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    Aspect="AspectFit"
                                    Margin="0,0,0,0" />
                                <Label
                                    Text="Login with Apple"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    TextColor="Black"
                                    Margin="10,0,0,0" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="AppleLoginBtn_Tapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </ContentView>
        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="Spinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:YesNoAlertModal
            x:Name="YesNoModal"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>
