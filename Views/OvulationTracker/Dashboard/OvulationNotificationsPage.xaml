<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.OvulationTracker.Dashboard.OvulationNotificationsPage"
    Background="White"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals"
    xmlns:dashComp="clr-namespace:OvulaeApp.Views.Components.Dashboard"
    xmlns:dashComp3="clr-namespace:OvulaeApp.Views.Components.Modals.Dashboard"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:dashTabs="clr-namespace:OvulaeApp.Views.Components.Tabs"
    xmlns:vm="clr-namespace:OvulaeApp.ViewModels.Shared"
    x:DataType="vm:PeriodOvulationNotificationsViewModel">

    <AbsoluteLayout>
        <Grid
            RowDefinitions="Auto,*,Auto"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">

            <!-- Header -->
            <dashTabs:DashboardHeader
                Grid.Row="0"
                x:Name="Header"
                LeftIconType="Menu" />

            <!-- Body -->
            <ScrollView
                Grid.Row="1">
                <VerticalStackLayout
                    Padding="20,20"
                    Spacing="25"
                    Background="WhiteSmoke">

                    <!-- TITLE -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center">
                        <Label
                            Text="Ovulation Tracker Alerts"
                            FontSize="22"
                            TextColor="{StaticResource ThemeClr3}"
                            FontAttributes="Bold"
                            FontFamily="Arial Black"
                            Margin="0,0,0,5" />
                    </HorizontalStackLayout>

                    <!-- Toggled Time -->
                    <VerticalStackLayout>
                        <HorizontalStackLayout
                            HorizontalOptions="Center">
                            <Label
                                Text="Choose own time for notifications?"
                                FontSize="14"
                                VerticalOptions="Center"
                                HorizontalOptions="End" />
                            <customCtrl:Switch
                                x:Name="ManualTimeSwitch"
                                Toggled="ManualTimeToggle"
                                IsToggled="{Binding ShowManualTime}"
                                Margin="5,0,0,0" />
                        </HorizontalStackLayout>
                        <Border
                            x:Name="ManualTimeInput"
                            BackgroundColor="{StaticResource ThemeClrPurple}"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource ThemeClrMain}"
                            StrokeThickness="0.5"
                            Margin="0,5,0,0"
                            IsVisible="{Binding ShowManualTime}"
                            Padding="15">
                            <VerticalStackLayout>
                                <Label
                                    Text="This is the time you will receive your first notification, should there be other notifications they will appear after."
                                    FontSize="10"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="Italic"
                                    TextColor="{StaticResource ThemeGray2}" />
                                <HorizontalStackLayout
                                    HorizontalOptions="Center"
                                    Margin="0,10,0,0">
                                    <Label
                                        Text="Time"
                                        FontSize="16"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End" />
                                    <customCtrl:CustomTimePicker
                                        SelectedTime="{Binding Notifications.PreferredNotificationTime}"
                                        TimeColor="{StaticResource ThemeClrMain}"
                                        FontSize="14"
                                        Margin="10,0,0,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- PHASE TIPS -->
                    <Border
                        BackgroundColor="#FFF3E0"
                        StrokeShape="RoundRectangle 10"
                        Stroke="Transparent">
                        <Border.Shadow>
                            <Shadow
                                Brush="DarkOrange"
                                Opacity="0.3"
                                Offset="0,4"
                                Radius="6" />
                        </Border.Shadow>
                        <VerticalStackLayout>
                            <Border
                                Stroke="Transparent"
                                Background="DarkOrange"
                                HeightRequest="10" />
                            <VerticalStackLayout
                                Spacing="15"
                                Padding="15">
                                <Label
                                    Text="🌸 Ovulation Phase Tips"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#E65100" />

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Follicular Phase Tips"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyFollicularPhaseTips}"
                                        Grid.Column="1" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Ovulation Day Tips"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyOvulationDayTips}"
                                        Grid.Column="1" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Luteal Phase Tips"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyLutealPhaseTips}"
                                        Grid.Column="1" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- FERTILITY MARKERS -->
                    <Border
                        BackgroundColor="#EDE7F6"
                        StrokeShape="RoundRectangle 10"
                        Stroke="Transparent">
                        <Border.Shadow>
                            <Shadow
                                Brush="Indigo"
                                Opacity="0.3"
                                Offset="0,4"
                                Radius="6" />
                        </Border.Shadow>
                        <VerticalStackLayout>
                            <Border
                                Stroke="Transparent"
                                Background="Indigo"
                                HeightRequest="10" />
                            <VerticalStackLayout
                                Spacing="15"
                                Padding="15">
                                <Label
                                    Text="👩‍💻 Fertility Markers"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#4A148C" />

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Cervical Mucus Changes"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyCervicalMucusChanges}"
                                        Grid.Column="1" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Temperature Shift Reminder"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyTemperatureShiftReminder}"
                                        Grid.Column="1" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Sex Timing Advice"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifySexTimingAdvice}"
                                        Grid.Column="1" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- LIFESTYLE & EDUCATION -->
                    <Border
                        BackgroundColor="#E8F5E9"
                        StrokeShape="RoundRectangle 10"
                        Stroke="Transparent">
                        <Border.Shadow>
                            <Shadow
                                Brush="DarkGreen"
                                Opacity="0.3"
                                Offset="0,4"
                                Radius="6" />
                        </Border.Shadow>
                        <VerticalStackLayout>
                            <Border
                                Stroke="Transparent"
                                Background="DarkGreen"
                                HeightRequest="10" />
                            <VerticalStackLayout
                                Padding="15"
                                Spacing="15">
                                <Label
                                    Text="🪴 Lifestyle &amp; Tips"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#1B5E20" />

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Fertility Nutrition Tips"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyFertilityNutritionTips}"
                                        Grid.Column="1" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="Mindfulness &amp; Relaxation"
                                        Grid.Column="0"
                                        FontSize="16"
                                        VerticalOptions="Center" />
                                    <customCtrl:Switch
                                        IsToggled="{Binding Notifications.NotifyMindfulnessAndRelaxation}"
                                        Grid.Column="1" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Save Preferences -->
                    <Border
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 25"
                        StrokeThickness="1.2"
                        Padding="20,8"
                        Margin="0,0,0,0"
                        HorizontalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,1">
                                <GradientStop
                                    Color="{StaticResource ThemeClr3}"
                                    Offset="0.0" />
                                <GradientStop
                                    Color="{StaticResource ThemeClr2}"
                                    Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.4"
                                Offset="0,4"
                                Radius="6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="SaveNotificationsPreferences" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout
                            Spacing="8"
                            HorizontalOptions="Center">
                            <Label
                                Text="Save Changes"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White"
                                VerticalOptions="Center"
                                FontFamily="Arial" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Bottom Tabs -->
            <dashTabs:DashboardBottomTab
                Grid.Row="2"
                x:Name="BaseTabs"
                Padding="0,0"
                ActiveTab="Alerts" />

        </Grid>
        <dashTabs:DashboardSideMenu
            x:Name="SideMenu"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="Spinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:TrackerSwitcher
            x:Name="ModuleTrackerSwitch"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:YesNoAlertModal
            x:Name="YesNoPopup"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashComp3:PregnancyTrackerOnboardModal
            x:Name="PregnancyTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashComp3:PeriodTrackerOnboardModal
            x:Name="PeriodTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashComp3:MenopauseTrackerOnboardModal
            x:Name="MenopauseTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>
