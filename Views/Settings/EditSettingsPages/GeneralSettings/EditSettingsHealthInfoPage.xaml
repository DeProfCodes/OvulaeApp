<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Settings.EditSettingsPages.GeneralSettings.EditSettingsHealthInfoPage"
    Background="White"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals"
    xmlns:dashModals="clr-namespace:OvulaeApp.Views.Components.Modals.Dashboard"
    xmlns:dashComp="clr-namespace:OvulaeApp.Views.Components.Dashboard"
    xmlns:custCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:custButtons="clr-namespace:OvulaeApp.Views.Components.Controls.Buttons"
    xmlns:dashTabs="clr-namespace:OvulaeApp.Views.Components.Tabs"
    xmlns:sharedComp="clr-namespace:OvulaeApp.Views.Components.Shared"
    xmlns:vm="clr-namespace:OvulaeApp.ViewModels.Settings"
    x:DataType="vm:EditSettingsUserHealthViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style
                x:Key="MenuDivider"
                TargetType="Border">
                <Setter
                    Property="HeightRequest"
                    Value="0.35" />
                <Setter
                    Property="Stroke"
                    Value="{StaticResource ThemeClrMain}" />
                <Setter
                    Property="Opacity"
                    Value="1" />
                <Setter
                    Property="HorizontalOptions"
                    Value="Fill" />
                <Setter
                    Property="Margin"
                    Value="20,0,10,0" />
            </Style>
            <Style
                x:Key="SettingsGroupContainerStyle"
                TargetType="Border">
                <Setter
                    Property="BackgroundColor"
                    Value="{StaticResource ThemeLightGray}" />
                <Setter
                    Property="Stroke"
                    Value="Transparent" />
                <Setter
                    Property="Padding"
                    Value="10,15,10,10" />
                <Setter
                    Property="Margin"
                    Value="0,10,0,10" />
                <Setter
                    Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle
                            CornerRadius="10" />
                    </Setter.Value>
                </Setter>
                <Setter
                    Property="Shadow">
                    <Setter.Value>
                        <Shadow
                            Brush="Black"
                            Opacity="0.3"
                            Offset="0,4"
                            Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="DetailsSeparator"
                TargetType="Border">
                <Setter
                    Property="HeightRequest"
                    Value="0.3" />
                <Setter
                    Property="Stroke"
                    Value="{StaticResource ThemeClr3}" />
                <Setter
                    Property="Background"
                    Value="{StaticResource ThemeClr3}" />
                <Setter
                    Property="HorizontalOptions"
                    Value="Fill" />
                <Setter
                    Property="Opacity"
                    Value="0.45" />
            </Style>
            <Style
                x:Key="FormLabelStyle"
                TargetType="Label">
                <Setter
                    Property="FontSize"
                    Value="13" />
                <Setter
                    Property="TextColor"
                    Value="{StaticResource Black}" />
                <Setter
                    Property="VerticalOptions"
                    Value="Center" />
                <Setter
                    Property="HorizontalTextAlignment"
                    Value="Center" />
            </Style>
            <Style
                x:Key="ChangeButtonStyle"
                TargetType="custButtons:GradientButton">
                <Setter
                    Property="FontAttributes"
                    Value="Bold" />
                <Setter
                    Property="FontSize"
                    Value="10" />
                <Setter
                    Property="ButtonPadding"
                    Value="5,5" />
                <Setter
                    Property="Margin"
                    Value="0,0,0,0" />
                <Setter
                    Property="Stroke"
                    Value="Transparent" />
                <Setter
                    Property="StrokeThickness"
                    Value="1.5" />
                <Setter
                    Property="CornerRadius"
                    Value="5" />
                <Setter
                    Property="HorizontalOptions"
                    Value="End" />
                <Setter
                    Property="ShadowOpacity"
                    Value="0.1" />
                <Setter
                    Property="ButtonTextColor"
                    Value="White" />
                <Setter
                    Property="GradientColorLeft"
                    Value="{StaticResource ThemeClr2}" />
                <Setter
                    Property="GradientColorRight"
                    Value="{StaticResource ThemeClr2}" />
            </Style>
            <Style
                x:Key="FormLabelValueStyle"
                TargetType="Label">
                <Setter
                    Property="FontSize"
                    Value="13" />
                <Setter
                    Property="FontAttributes"
                    Value="Bold,Italic" />
                <Setter
                    Property="VerticalOptions"
                    Value="Center" />
                <Setter
                    Property="HorizontalTextAlignment"
                    Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <!-- Scrollable Content -->
        <ContentView
            x:Name="MainPageContainer"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">
            <Grid
                RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <dashTabs:DashboardHeader
                    Grid.Row="0"
                    x:Name="Header"
                    LeftIconType="Menu" />

                <!-- Body -->
                <ScrollView
                    Grid.Row="1">

                    <Grid
                        RowDefinitions="Auto,*"
                        Background="whitesmoke">

                        <!-- Page Title -->
                        <VerticalStackLayout
                            Grid.Row="0">
                            <HorizontalStackLayout
                                Padding="10,10">
                                <Border
                                    x:Name="BackBtnBorder"
                                    Padding="5,5"
                                    StrokeShape="RoundRectangle 10"
                                    Background="Transparent"
                                    Margin="0,0,0,0"
                                    Stroke="Transparent">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="BackButtonTapped" />
                                    </Border.GestureRecognizers>
                                    <Image
                                        Source="left_chev_edge.png"
                                        WidthRequest="20"
                                        HeightRequest="20"/>
                                </Border>
                                <Label
                                    x:Name="PageTitleLabel"
                                    Text="Edit Health Details"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    Margin="10,-3,0,0"
                                    TextColor="{StaticResource ThemeClrMain}" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="1"
                            Padding="15,0"
                            Margin="0,0"
                            Background="#ECE5DD">
                            
                            <Border
                                Style="{StaticResource SettingsGroupContainerStyle}">
                                <VerticalStackLayout>

                                    <VerticalStackLayout
                                        Spacing="5">

                                        <Label
                                            Text="Health Profile Settings"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center" />

                                        <Border
                                            Style="{StaticResource DetailsSeparator}"
                                            Margin="0,10,0,0" />

                                        <Grid
                                            ColumnDefinitions="*,*,*">
                                            <Label
                                                Grid.Column="0"
                                                Text="Weight"
                                                Style="{StaticResource FormLabelStyle}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding WeightProp.Value}"
                                                TextColor="{Binding WeightProp.Color}"
                                                Style="{StaticResource FormLabelValueStyle}" />

                                            <custButtons:GradientButton
                                                Grid.Column="2"
                                                Text="change"
                                                Style="{StaticResource ChangeButtonStyle}"
                                                TappedWithParameter="UpdateSingleItem"
                                                CommandParameter="WeightUpdate" />

                                        </Grid>

                                        <Border
                                            Style="{StaticResource DetailsSeparator}" />

                                        <Grid
                                            ColumnDefinitions="*,*,*"
                                            Margin="0,0,0,0">
                                            <Label
                                                Grid.Column="0"
                                                Text="Height"
                                                Style="{StaticResource FormLabelStyle}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding HeightProp.Value}"
                                                TextColor="{Binding HeightProp.Color}"
                                                Style="{StaticResource FormLabelValueStyle}" />

                                            <custButtons:GradientButton
                                                Grid.Column="2"
                                                Text="change"
                                                Style="{StaticResource ChangeButtonStyle}"
                                                TappedWithParameter="UpdateSingleItem"
                                                CommandParameter="HeightUpdate" />

                                        </Grid>

                                        <Border
                                            Style="{StaticResource DetailsSeparator}" />

                                        <Grid
                                            ColumnDefinitions="*,*,*"
                                            Margin="0,0,0,0">
                                            <VerticalStackLayout
                                                Grid.Column="0"
                                                Margin="0,8,0,0"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="BMI"
                                                    Style="{StaticResource FormLabelStyle}" />
                                                <Label
                                                    Text="(Body Mass Index)"
                                                    FontSize="8"
                                                    FontAttributes="Italic"
                                                    TextColor="{StaticResource ThemeGray2}"
                                                    HorizontalTextAlignment="Center" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding BMIProp.Value}"
                                                TextColor="{Binding BMIProp.Color}"
                                                Style="{StaticResource FormLabelValueStyle}" />

                                        </Grid>

                                        <Border
                                            Style="{StaticResource DetailsSeparator}" />

                                        <Grid
                                            ColumnDefinitions="*,*,*"
                                            Margin="0,0,0,0">
                                            <Label
                                                Grid.Column="0"
                                                Text="Blood Type"
                                                Style="{StaticResource FormLabelStyle}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding BloodTypeProp.Value}"
                                                TextColor="{Binding BloodTypeProp.Color}"
                                                Style="{StaticResource FormLabelValueStyle}" />

                                            <custButtons:GradientButton
                                                Grid.Column="2"
                                                Text="change"
                                                Style="{StaticResource ChangeButtonStyle}"
                                                TappedWithParameter="UpdateSingleItem"
                                                CommandParameter="BloodType" />

                                        </Grid>

                                        <Border
                                            Style="{StaticResource DetailsSeparator}" />

                                    </VerticalStackLayout>

                                    <custButtons:GradientButton
                                        x:Name="EditDetailsBtn"
                                        Text="Edit Details"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        ButtonPadding="20,10"
                                        Margin="0,10,0,0"
                                        Stroke="Transparent"
                                        StrokeThickness="1.5"
                                        CornerRadius="25"
                                        HorizontalOptions="Center"
                                        ShadowOpacity="0.4"
                                        ButtonTextColor="White"
                                        GradientColorLeft="{StaticResource ThemeClr3}"
                                        GradientColorRight="{StaticResource ThemeClr2}"
                                        IsButtonEnabled="True"
                                        Tapped="EditDetailsButtonTapped" />
                                    
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                x:Name="FormBorder"
                                Style="{StaticResource SettingsGroupContainerStyle}"
                                IsVisible="False">

                                <VerticalStackLayout>

                                    <Grid
                                        ColumnDefinitions="*,Auto">

                                        <Label
                                            Grid.Column="0"
                                            Text="Edit Health Info"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Margin="0,0,-30,0"
                                            HorizontalOptions="Center"
                                            TextColor="{StaticResource ThemeClrMain}" />

                                        <custButtons:GradientButton
                                            Text="X"
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="10"
                                            Padding="5,0"
                                            Margin="0,0,0,0"
                                            Stroke="Transparent"
                                            StrokeThickness="1.5"
                                            CornerRadius="5"
                                            HorizontalOptions="End"
                                            ShadowOpacity="0"
                                            ButtonTextColor="White"
                                            GradientColorLeft="{StaticResource ThemeClrMain}"
                                            GradientColorRight="{StaticResource ThemeClrMain}"
                                            IsButtonEnabled="True"
                                            IsVisible="True"
                                            Tapped="CloseModalPage" />
                                    </Grid>

                                    <VerticalStackLayout
                                        Padding="5,0">

                                        <Border
                                            Style="{StaticResource DetailsSeparator}"
                                            Margin="0,10,0,0" />

                                        <VerticalStackLayout
                                            Margin="0,20,0,0"
                                            x:Name="WeightEdit"
                                            IsVisible="False">
                                            <Label
                                                Text="What is your current weight?"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Black}" />

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                RowDefinitions="*,*"
                                                HorizontalOptions="Start"
                                                Margin="10,20,0,0">
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="Enter weight"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Black}"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center" />
                                                <customCtrl:NumericStepper
                                                    x:Name="WeightValue"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Value="80"
                                                    Min="30"
                                                    OuterStroke="{StaticResource ThemeClr3}"
                                                    EntryTextColor="DarkBlue"
                                                    OuterBackground="{StaticResource ThemeClr3}"
                                                    EntryBackground="White"
                                                    DecreaseBackground="{StaticResource ThemeClr3}"
                                                    DecreaseIconSource="chev_down_white.png"
                                                    IncreaseBackground="{StaticResource ThemeClr3}"
                                                    IncreaseIconSource="chev_up_white.png"
                                                    Max="250"
                                                    HorizontalOptions="Start"
                                                    FontSize="12"
                                                    Margin="10,0,0,0" />

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="Unit"
                                                    FontSize="12"
                                                    Margin="0,10,0,0"
                                                    TextColor="{StaticResource Black}"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center" />
                                                <dashComp:CategorySelector
                                                    x:Name="WeightUnit"
                                                    CategoryString="Kg|lbs"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="20,10,0,0"
                                                    FontSize="14"
                                                    Padding="0,0,0,0"
                                                    ActiveCategoryStrokeColor="{StaticResource ThemeClrMain}"
                                                    InActiveCategoryStrokeColor="{StaticResource ThemeClrMain}"
                                                    ActiveCategoryBackgroundColor="{StaticResource ThemeClrMain}"
                                                    ItemSpacing="-1"
                                                    CategoryCornerRadius="0"
                                                    IsCategoryFilter="True"
                                                    InActiveCategoryTextColor="Black" />
                                            </Grid>

                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Margin="0,20,0,0"
                                            x:Name="HeightEdit"
                                            IsVisible="False">
                                            
                                            <Label
                                                Text="Enter your height"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Black}" />

                                            <Grid
                                                ColumnDefinitions="*,*"
                                                RowDefinitions="*,*"
                                                HorizontalOptions="Start"
                                                Margin="10,10,0,0">
                                                <Label
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Text="Enter height"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Black}"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center" />
                                                <customCtrl:NumericStepper
                                                    x:Name="HeightValue"
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Value="160"
                                                    Min="50"
                                                    OuterStroke="{StaticResource ThemeClr3}"
                                                    EntryTextColor="DarkBlue"
                                                    OuterBackground="{StaticResource ThemeClr3}"
                                                    EntryBackground="White"
                                                    DecreaseBackground="{StaticResource ThemeClr3}"
                                                    DecreaseIconSource="chev_down_white.png"
                                                    IncreaseBackground="{StaticResource ThemeClr3}"
                                                    IncreaseIconSource="chev_up_white.png"
                                                    Max="350"
                                                    HorizontalOptions="Start"
                                                    FontSize="14"
                                                    Margin="10,0,0,0" />

                                                <Label
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Text="Unit"
                                                    FontSize="12"
                                                    Margin="0,10,0,0"
                                                    TextColor="{StaticResource Black}"
                                                    HorizontalTextAlignment="End"
                                                    VerticalTextAlignment="Center" />
                                                <dashComp:CategorySelector
                                                    x:Name="HeightUnit"
                                                    CategoryString="cm|ft/in"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="20,10,0,0"
                                                    FontSize="14"
                                                    Padding="0,0,0,0"
                                                    ActiveCategoryStrokeColor="{StaticResource ThemeClrMain}"
                                                    InActiveCategoryStrokeColor="{StaticResource ThemeClrMain}"
                                                    ActiveCategoryBackgroundColor="{StaticResource ThemeClrMain}"
                                                    ItemSpacing="-1"
                                                    CategoryCornerRadius="0"
                                                    IsCategoryFilter="True"
                                                    InActiveCategoryTextColor="Black" />
                                            </Grid>

                                        </VerticalStackLayout>

                                        <VerticalStackLayout
                                            Margin="0,20,0,0"
                                            x:Name="BloodTypeEdit"
                                            IsVisible="False">
                                            <Label
                                                Text="What is your blood type?"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Black}" />

                                            <sharedComp:SelectComponent2
                                                x:Name="BloodTypeOption"
                                                OptionList="A+|A−|B+|B-|AB+|AB-|O+|O-"
                                                IsHorizontal="True"
                                                OptionSpacing="4"
                                                EnableWrapping="True"
                                                OptionFontSize="11"
                                                BorderPadding="8,5"
                                                SelectionType="Single"
                                                OptionCornerRadius="5"
                                                Margin="0,10,0,0" />

                                        </VerticalStackLayout>

                                        <Border
                                            Margin="0,20,0,0"
                                            Style="{StaticResource DetailsSeparator}" />

                                        <custButtons:GradientButton
                                            Grid.Column="1"
                                            Text="Update Settings"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            ButtonPadding="20,10"
                                            Margin="0,10,0,0"
                                            Stroke="Transparent"
                                            StrokeThickness="1.5"
                                            CornerRadius="5"
                                            HorizontalOptions="Center"
                                            ShadowOpacity="0.0"
                                            ButtonTextColor="White"
                                            GradientColorLeft="{StaticResource ThemeClrMain}"
                                            GradientColorRight="{StaticResource ThemeClrMain}"
                                            IsButtonEnabled="True"
                                            Tapped="SaveButton_Clicked" />

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>
                            
                        </VerticalStackLayout>

                    </Grid>
                </ScrollView>

                <!-- Bottom Tabs -->
                <dashTabs:DashboardBottomTab
                    Grid.Row="2"
                    x:Name="BaseTabs"
                    Padding="0,0"
                    ActiveTab="None" />

            </Grid>
        </ContentView>
        <dashTabs:DashboardSideMenu
            x:Name="SideMenu"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="Spinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:MultiPurposeChangeModal
            x:Name="ChangeRequestModal"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:TrackerSwitcher
            x:Name="ModuleTrackerSwitch"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PregnancyCompleteModal
            x:Name="PregnancyComplete"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PregnancyTrackerOnboardModal
            x:Name="PregnancyTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PeriodTrackerOnboardModal
            x:Name="PeriodTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:MenopauseTrackerOnboardModal
            x:Name="MenopauseTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:YesNoAlertModal
            x:Name="YesNoModal"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>
