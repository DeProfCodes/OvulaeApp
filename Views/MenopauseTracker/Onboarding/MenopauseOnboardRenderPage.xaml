        <adPages:AdModuleFeaturePage
            x:Name="PartnerShareAdPage"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
            NextClicked="NextOnboardBtn_Clicked"
            BackClicked="IntraMarketingPageContainer_BackClicked"
            DotCurrentIndex="18"
            DotTotalIndices="20"
            FeatureType="PartnerShare"
            IsVisible="False" />

        <!-- END/Intra Marketing Pages -->

        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="AppSpinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <customCtrl:YearPicker
            x:Name="MyYearPicker"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>
