<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="OvulaeApp.Views.Components.Modals.Dashboard.MenopauseTrackerOnboardModal"
    x:Name="Root"
    xmlns:sharedComp="clr-namespace:OvulaeApp.Views.Components.Shared"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:behaviors="clr-namespace:OvulaeApp.Helpers.UI.Behaviors"
    Background="#80000000">

    <!-- Fullscreen blocker -->
    <Grid
        BackgroundColor="#80000000"
        InputTransparent="False"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid.Behaviors>
            <behaviors:DismissKeyboardBehavior />
        </Grid.Behaviors>
        
        <Border
            x:Name="MainContainer"
            Background="White"
            Padding="0"
            StrokeShape="RoundRectangle 16"
            Stroke="{StaticResource ThemeClr2}"
            StrokeThickness="2"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            WidthRequest="320"
            HeightRequest="300">
            <Grid
                RowDefinitions="Auto,*,Auto">
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Background="#FFF5FF"
                    Padding="10">
                    <Label
                        Grid.Column="0"
                        x:Name="ModalTitle"
                        Text="Menopause Tracker Setup"
                        Padding="4,0,0,0"
                        TextColor="{StaticResource ThemeClrMain}"
                        HorizontalTextAlignment="Center"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Border
                        Grid.Column="1"
                        StrokeShape="RoundRectangle 5"
                        Stroke="Transparent"
                        Background="{StaticResource ThemeClrMain}"
                        Padding="10,1,10,1"
                        HeightRequest="25">
                        <Label
                            Text="X"
                            TextColor="White"
                            FontFamily="Arial Black"
                            HorizontalTextAlignment="Start"
                            FontSize="14"
                            FontAttributes="Bold" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="CloseButton_Tapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <ScrollView
                    Grid.Row="1">

                    <VerticalStackLayout>

                        <Label
                            Text="You are setting up for menopause tracker"
                            FontAttributes="Bold"
                            FontSize="14"
                            Margin="5,10,5,0"
                            HorizontalOptions="Center"
                            TextColor="Black" />

                        <Label
                            Text="Please tell us about your current experience."
                            FontSize="12"
                            Margin="10,10,10,3"
                            HorizontalTextAlignment="Center"
                            TextColor="Black" />
                        
                        <!-- Intro -->
                        <VerticalStackLayout
                            x:Name="SymptomsSelectionQuestions">

                            <Label
                                Text="Please select all you are feeling"
                                FontAttributes="Bold"
                                FontSize="14"
                                Margin="10,5,10,0"
                                HorizontalOptions="Center"
                                TextColor="{StaticResource ThemeClrMain}" />

                            <sharedComp:SelectComponent2
                                x:Name="SymptomsQuestionOptions"
                                OptionList="Irregular periods (occasional)|Irregular periods (frequently)|Hot flashes|Night sweats|Mood swings|Using hormone therapy|12+ months since last period"
                                OptionSpacing="8"
                                OptionFontSize="12"
                                IsFullWidth="True"
                                OptionsHorizontalAlignment="Center"
                                SelectionType="Multiple"
                                Margin="55,20,55,20"
                                SelectionChanged="SymptomsQuestionOptions_SelectionChanged" />
                        
                        </VerticalStackLayout>

                        <!-- LMP -->
                        <VerticalStackLayout
                            x:Name="LMPOption"
                            IsVisible="False">
                            <Label
                                Text="When did you last period start?"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="0,20,0,20" />
                            <Grid
                                ColumnDefinitions="*,*">
                                <Label
                                    Grid.Column="0"
                                    Text="Select Date"
                                    FontSize="14"
                                    HorizontalTextAlignment="End"
                                    VerticalOptions="Center"
                                    TextColor="{StaticResource Black}"
                                    Margin="0,0,10,0" />

                                <customCtrl:DatePicker
                                    Grid.Column="1"
                                    x:Name="LastPeriodDate"
                                    DateColor="{StaticResource White}"
                                    Background="Transparent"
                                    PickerBackground="{StaticResource ThemeClrMain}"
                                    DropdownIconSource="chev_down_white.png"
                                    FontSize="12"
                                    HeightRequest="40"
                                    Padding="5,0"
                                    CornerRadius="10"
                                    HorizontalOptions="Start"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Outro-->
                        <VerticalStackLayout
                            x:Name="NavigateToMenopauseTracker"
                            IsVisible="False">
                            <Label
                                Text="Thank you, Click finish to switch to Menopause Tracker now."
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource ThemeClr2}"
                                Margin="10,20,10,20" />
                            
                        </VerticalStackLayout>
                        
                    </VerticalStackLayout>

                </ScrollView>

                <Border
                    Grid.Row="2"
                    StrokeShape="RoundRectangle 5"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeLightGray}"
                    Margin="0,0,0,0">
                    <HorizontalStackLayout
                        HorizontalOptions="CenterAndExpand">
                        <Border
                            x:Name="BackBtnTxt"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            IsVisible="False"
                            Stroke="Transparent"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="0,5,0,5">
                            <Label
                                Text="Back"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="BackButtonTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            x:Name="NextBtnTxt"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                            Stroke="Transparent"
                            Background="{StaticResource ThemeClrMain}"
                            Padding="15,5,15,5"
                            Margin="5,5,0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="NextButtonTapped" />
                            </Border.GestureRecognizers>
                            <Label
                                x:Name="NextButtonLabel"
                                Text="Next"
                                FontAttributes="Bold"
                                FontSize="14"
                                FontFamily="Arial Black"
                                TextColor="White" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>