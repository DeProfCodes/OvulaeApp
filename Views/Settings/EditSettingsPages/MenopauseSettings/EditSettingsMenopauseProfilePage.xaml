<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custButtons="clr-namespace:OvulaeApp.Views.Components.Controls.Buttons"
    xmlns:customCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:vm="clr-namespace:OvulaeApp.ViewModels.Settings"
    xmlns:components="clr-namespace:OvulaeApp.Views.Components.Modals"
    xmlns:dashModals="clr-namespace:OvulaeApp.Views.Components.Modals.Dashboard"
    xmlns:dashComp="clr-namespace:OvulaeApp.Views.Components.Dashboard"
    xmlns:custCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    xmlns:dashTabs="clr-namespace:OvulaeApp.Views.Components.Tabs"
    xmlns:sharedComp="clr-namespace:OvulaeApp.Views.Components.Shared"
    x:Class="OvulaeApp.Views.Settings.EditSettingsPages.MenopauseSettings.EditMenopauseProfilePage"
    Background="White"
    x:DataType="vm:EditSettingMenopauseViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style
                x:Key="MenuDivider"
                TargetType="Border">
                <Setter
                    Property="HeightRequest"
                    Value="0.35" />
                <Setter
                    Property="Stroke"
                    Value="{StaticResource ThemeClrMain}" />
                <Setter
                    Property="Opacity"
                    Value="1" />
                <Setter
                    Property="HorizontalOptions"
                    Value="Fill" />
                <Setter
                    Property="Margin"
                    Value="20,0,10,0" />
            </Style>
            <Style
                x:Key="SettingsGroupContainerStyle"
                TargetType="Border">
                <Setter
                    Property="BackgroundColor"
                    Value="{StaticResource ThemeLightGray}" />
                <Setter
                    Property="Stroke"
                    Value="Transparent" />
                <Setter
                    Property="Padding"
                    Value="10,15,10,10" />
                <Setter
                    Property="Margin"
                    Value="0,10,0,10" />
                <Setter
                    Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle
                            CornerRadius="10" />
                    </Setter.Value>
                </Setter>
                <Setter
                    Property="Shadow">
                    <Setter.Value>
                        <Shadow
                            Brush="Black"
                            Opacity="0.3"
                            Offset="0,4"
                            Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
                x:Key="DetailsSeparator"
                TargetType="Border">
                <Setter
                    Property="HeightRequest"
                    Value="0.3" />
                <Setter
                    Property="Stroke"
                    Value="{StaticResource ThemeClr3}" />
                <Setter
                    Property="Background"
                    Value="{StaticResource ThemeClr3}" />
                <Setter
                    Property="HorizontalOptions"
                    Value="Fill" />
                <Setter
                    Property="Opacity"
                    Value="0.45" />
            </Style>
            <Style
                x:Key="FormLabelStyle"
                TargetType="Label">
                <Setter
                    Property="FontSize"
                    Value="13" />
                <Setter
                    Property="TextColor"
                    Value="{StaticResource Black}" />
                <Setter
                    Property="VerticalOptions"
                    Value="Center" />
                <Setter
                    Property="HorizontalTextAlignment"
                    Value="Center" />
            </Style>
            <Style
                x:Key="ChangeButtonStyle"
                TargetType="custButtons:GradientButton">
                <Setter
                    Property="FontAttributes"
                    Value="Bold" />
                <Setter
                    Property="FontSize"
                    Value="10" />
                <Setter
                    Property="ButtonPadding"
                    Value="5,5" />
                <Setter
                    Property="Margin"
                    Value="0,0,0,0" />
                <Setter
                    Property="Stroke"
                    Value="Transparent" />
                <Setter
                    Property="StrokeThickness"
                    Value="1.5" />
                <Setter
                    Property="CornerRadius"
                    Value="5" />
                <Setter
                    Property="HeightRequest"
                    Value="30" />
                <Setter
                    Property="HorizontalOptions"
                    Value="End" />
                <Setter
                    Property="ShadowOpacity"
                    Value="0.1" />
                <Setter
                    Property="ButtonTextColor"
                    Value="White" />
                <Setter
                    Property="GradientColorLeft"
                    Value="{StaticResource ThemeClr2}" />
                <Setter
                    Property="GradientColorRight"
                    Value="{StaticResource ThemeClr2}" />
            </Style>
            <Style
                x:Key="FormLabelValueStyle"
                TargetType="Label">
                <Setter
                    Property="FontSize"
                    Value="13" />
                <Setter
                    Property="FontAttributes"
                    Value="Bold,Italic" />
                <Setter
                    Property="VerticalOptions"
                    Value="Center" />
                <Setter
                    Property="HorizontalTextAlignment"
                    Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <AbsoluteLayout>
        <Grid
            RowDefinitions="Auto,*,Auto"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">

            <!-- Header -->
            <dashTabs:DashboardHeader
                Grid.Row="0"
                x:Name="Header"
                LeftIconType="Menu" />



            <!-- Main Content -->
            <!-- Body -->
            <ScrollView
                Grid.Row="1">


                <Grid
                    RowDefinitions="Auto,*"
                    Background="whitesmoke">

                    <!-- Page Title -->
                    <VerticalStackLayout
                        Grid.Row="0">
                        <HorizontalStackLayout
                            Padding="10,10">
                            <Border
                                x:Name="BackBtnBorder"
                                Padding="5,5"
                                StrokeShape="RoundRectangle 10"
                                Background="Transparent"
                                Margin="0,0,0,0"
                                Stroke="Transparent">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="BackButtonTapped" />
                                </Border.GestureRecognizers>
                                <Image
                                    Source="left_chev_edge.png"
                                    WidthRequest="20"
                                    HeightRequest="20" />
                            </Border>
                            <Label
                                x:Name="PageTitleLabel"
                                Text="Menopause Settings"
                                FontSize="24"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                Margin="10,-3,0,0"
                                TextColor="{StaticResource ThemeClrMain}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Padding="15,0"
                        Margin="0,0"
                        Background="#ECE5DD">

                        <Border
                            Style="{StaticResource SettingsGroupContainerStyle}">

                            <VerticalStackLayout
                                Spacing="7">
                                <Label
                                    Text="Edit Menopause Details"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center" />

                                <Border
                                    Style="{StaticResource DetailsSeparator}" />

                                <Grid
                                    ColumnDefinitions="*,*,*">

                                    <VerticalStackLayout
                                        Grid.Column="0"
                                        Margin="0,8,0,0">
                                        <Label
                                            Text="LMP Date"
                                            Style="{StaticResource FormLabelStyle}" />
                                        <Label
                                            Text="(Last Period Date)"
                                            FontSize="8"
                                            FontAttributes="Italic"
                                            TextColor="{StaticResource ThemeGray2}"
                                            HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding LastPeriodDate.Value}"
                                        TextColor="{Binding LastPeriodDate.Color}"
                                        Style="{StaticResource FormLabelValueStyle}" />

                                    <custButtons:GradientButton
                                        Grid.Column="2"
                                        Text="change"
                                        Style="{StaticResource ChangeButtonStyle}"
                                        TappedWithParameter="UpdateSingleItem"
                                        CommandParameter="LMP" />

                                </Grid>

                                <Border
                                    Style="{StaticResource DetailsSeparator}" />

                                <Grid
                                    ColumnDefinitions="*,*,*">

                                    <Label
                                        Text="Using Hormonal Treatment"
                                        Grid.Column="0"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource FormLabelStyle}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding IsUsingHormonalTreatment.Value}"
                                        TextColor="{Binding IsUsingHormonalTreatment.Color}"
                                        Style="{StaticResource FormLabelValueStyle}" />

                                    <custButtons:GradientButton
                                        Grid.Column="2"
                                        Text="change"
                                        Style="{StaticResource ChangeButtonStyle}"
                                        TappedWithParameter="UpdateSingleItem"
                                        CommandParameter="HRT" />

                                </Grid>

                                <Border
                                    Style="{StaticResource DetailsSeparator}" />

                                <custButtons:GradientButton
                                    x:Name="EditDetailsBtn"
                                    Text="Edit Profile"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    ButtonPadding="20,10"
                                    Margin="0,10,0,0"
                                    Stroke="Transparent"
                                    StrokeThickness="1.5"
                                    CornerRadius="25"
                                    HorizontalOptions="Center"
                                    ShadowOpacity="0.4"
                                    ButtonTextColor="White"
                                    GradientColorLeft="{StaticResource ThemeClr3}"
                                    GradientColorRight="{StaticResource ThemeClr2}"
                                    IsButtonEnabled="True"
                                    Tapped="EditDetailsButtonTapped" />

                            </VerticalStackLayout>
                        </Border>

                        <Border
                            x:Name="FormBorder"
                            Style="{StaticResource SettingsGroupContainerStyle}"
                            IsVisible="False">

                            <VerticalStackLayout>

                                <Grid
                                    ColumnDefinitions="*,Auto">

                                    <Label
                                        Grid.Column="0"
                                        Text="Edit Menopause Details"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        Margin="0,0,-30,0"
                                        HorizontalOptions="Center"
                                        TextColor="{StaticResource ThemeClrMain}" />

                                    <custButtons:GradientButton
                                        Text="X"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Padding="5,0"
                                        Margin="0,0,0,0"
                                        Stroke="Transparent"
                                        StrokeThickness="1.5"
                                        CornerRadius="5"
                                        HorizontalOptions="End"
                                        ShadowOpacity="0"
                                        ButtonTextColor="White"
                                        GradientColorLeft="{StaticResource ThemeClrMain}"
                                        GradientColorRight="{StaticResource ThemeClrMain}"
                                        IsButtonEnabled="True"
                                        IsVisible="True"
                                        Tapped="CloseModalPage" />
                                </Grid>

                                <VerticalStackLayout
                                    Padding="5,0">

                                    <Border
                                        Style="{StaticResource DetailsSeparator}"
                                        Margin="0,10,0,0" />

                                    <VerticalStackLayout
                                        Margin="0,20,0,0"
                                        x:Name="LMPedit"
                                        IsVisible="False">
                                        <Label
                                            Text="When did your last period start?"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Black}" />

                                        <HorizontalStackLayout
                                            Margin="0,20,0,0"
                                            HorizontalOptions="Center">

                                            <Label
                                                Text="Select Date"
                                                FontSize="12"
                                                TextColor="{StaticResource Black}"
                                                VerticalOptions="Center"
                                                Margin="0,0,5,0" />
                                            <customCtrl:DatePicker
                                                x:Name="LMPDate"
                                                DateColor="{StaticResource White}"
                                                Background="Transparent"
                                                PickerBackground="{StaticResource ThemeClrMain}"
                                                DropdownIconSource="chev_down_white.png"
                                                FontSize="12"
                                                HeightRequest="40"
                                                Padding="5,0"
                                                CornerRadius="10" />

                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        Margin="0,20,0,0"
                                        x:Name="HormanalTreatment"
                                        IsVisible="True">
                                        <Label
                                            Text="Are you using any hormonal treatment?"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource Black}" />

                                        <HorizontalStackLayout
                                            Margin="0,20,0,0"
                                            HorizontalOptions="Center">

                                            <sharedComp:SelectComponent2
                                                x:Name="HormonalTreatment"
                                                OptionList="Yes|No"
                                                OptionSpacing="8"
                                                OptionFontSize="12"
                                                IsFullWidth="True"
                                                BorderPadding="30,10"
                                                IsHorizontal="True"
                                                SelectionType="Single"
                                                Margin="0,0,0,0" />

                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Border
                                        Margin="0,20,0,0"
                                        Style="{StaticResource DetailsSeparator}" />

                                    <custButtons:GradientButton
                                        Grid.Column="1"
                                        Text="Update Settings"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        ButtonPadding="20,10"
                                        Margin="0,10,0,0"
                                        Stroke="Transparent"
                                        StrokeThickness="1.5"
                                        CornerRadius="5"
                                        HorizontalOptions="Center"
                                        ShadowOpacity="0.0"
                                        ButtonTextColor="White"
                                        GradientColorLeft="{StaticResource ThemeClrMain}"
                                        GradientColorRight="{StaticResource ThemeClrMain}"
                                        IsButtonEnabled="True"
                                        Tapped="SaveChangesTapped" />

                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>
            </ScrollView>

            <!-- Bottom Tabs -->
            <dashTabs:DashboardBottomTab
                Grid.Row="2"
                x:Name="BaseTabs"
                Padding="0,0"
                ActiveTab="None" />

        </Grid>
        <dashTabs:DashboardSideMenu
            x:Name="SideMenu"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:BrandedLoader
            x:Name="AppLoader"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:SpinnerLoader
            x:Name="Spinner"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:MultiPurposeChangeModal
            x:Name="ChangeRequestModal"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <customCtrl:YearPicker
            x:Name="MyYearPicker"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:TrackerSwitcher
            x:Name="ModuleTrackerSwitch"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PregnancyCompleteModal
            x:Name="PregnancyComplete"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PregnancyTrackerOnboardModal
            x:Name="PregnancyTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:PeriodTrackerOnboardModal
            x:Name="PeriodTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <dashModals:MenopauseTrackerOnboardModal
            x:Name="MenopauseTrackerOnBoard"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
        <components:YesNoAlertModal
            x:Name="YesNoModal"
            IsVisible="False"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />
    </AbsoluteLayout>
</ContentPage>