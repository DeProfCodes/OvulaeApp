<ContentView
    x:Class="OvulaeApp.Views.Components.Dashboard.TipCheckboxCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custCtrl="clr-namespace:OvulaeApp.Views.Components.Controls"
    x:Name="Root">

    <Border
        Padding="5,7,5,9"
        StrokeShape="RoundRectangle 8"
        Stroke="Transparent"
        Background="{Binding ContainerBGColor, Source={x:Reference Root}}">

        <VerticalStackLayout
            Spacing="5">
            <Grid
                ColumnDefinitions="*,Auto">
                <Label
                    x:Name="TitleLabel"
                    Grid.Column="0"
                    Text="{Binding TitleText, Source={x:Reference Root}}"
                    FontSize="{Binding TitleLabelFontSize, Source={x:Reference Root}}"
                    FontAttributes="Bold"
                    TextColor="{Binding TitleTextColor, Source={x:Reference Root}}"
                    HorizontalOptions="Center" />

                <custCtrl:Checkbox
                    x:Name="CheckBox"
                    Grid.Column="1"
                    WidthRequest="{Binding CheckboxSize, Source={x:Reference Root}}"
                    HeightRequest="{Binding CheckboxSize, Source={x:Reference Root}}"
                    Margin="0,0,5,0"
                    IsChecked="{Binding IsChecked, Source={x:Reference Root}, Mode=TwoWay}" />
            </Grid>

            <Label
                Text="{Binding SubText, Source={x:Reference Root}}"
                FontSize="{Binding SubTextFontSize, Source={x:Reference Root}}"
                FontAttributes="Italic"
                TextColor="{Binding SubTextColor, Source={x:Reference Root}}"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Border>
</ContentView>