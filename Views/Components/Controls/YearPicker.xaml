<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OvulaeApp.Views.Components.Controls.YearPicker"
    xmlns:converters="clr-namespace:OvulaeApp.Helpers.UI.Convertors"
    x:Name="MyYearPicker"
    IsVisible="False"
    BackgroundColor="#80000000"
    ZIndex="200">
    <!-- dimmed background -->

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:SelectedYearMatchConverter
                x:Key="SelectedYearMatchConverter" />
            <!-- Add other converters if needed -->
        </ResourceDictionary>
    </ContentView.Resources>
    
    <Border
        Background="white"
        Padding="0"
        StrokeShape="RoundRectangle 16"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Stroke="{StaticResource ThemeClr2}"
        StrokeThickness="2">
        <Grid
            RowDefinitions="Auto,*,Auto">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto"
                Background="#FFF5FF"
                Padding="10">
                <Label
                    Grid.Column="0"
                    x:Name="PopupTitle"
                    Text="Please select Year"
                    Padding="8,0,0,0"
                    TextColor="{StaticResource ThemeClrMain}"
                    HorizontalTextAlignment="Center"
                    FontSize="18"
                    FontAttributes="Bold" />
                <Border
                    Grid.Column="1"
                    StrokeShape="RoundRectangle 5"
                    Stroke="Transparent"
                    Background="{StaticResource ThemeClrMain}"
                    Padding="10,1,10,1">
                    <Label
                        Text="X"
                        TextColor="White"
                        FontFamily="Arial Black"
                        HorizontalTextAlignment="Start"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="CloseButtonTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <Border
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="10,10,10,0"
                Stroke="Transparent"
                WidthRequest="250"
                StrokeShape="RoundRectangle 20">
                <VerticalStackLayout
                    Spacing="15">
                    <ScrollView
                        MaximumHeightRequest="250"
                        VerticalScrollBarVisibility="Always">
                        <StackLayout
                            BindableLayout.ItemsSource="{Binding Years}"
                            Spacing="0"
                            Padding="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        HeightRequest="40"
                                        Margin="5,2"
                                        Padding="10,5"
                                        BackgroundColor="{StaticResource ThemeLightGray}"
                                        Stroke="Transparent"
                                        BindingContext="{Binding .}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="YearSelectTapped" />
                                        </Border.GestureRecognizers>
                                        <Label
                                            Text="{Binding .}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            FontFamily="Arial Black"
                                            TextColor="{StaticResource ThemeClr2}"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </StackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Row="2"
                StrokeShape="RoundRectangle 5"
                HorizontalOptions="Center"
                Stroke="Transparent"
                Background="{StaticResource ThemeClrMain}"
                Padding="15,5,15,5"
                Margin="0,0,0,5">
                <Label
                    x:Name="CloseBtnTxt"
                    Text="Close"
                    FontAttributes="Bold"
                    FontSize="14"
                    FontFamily="Arial Black"
                    TextColor="White" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="CloseButtonTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Border>
</ContentView>